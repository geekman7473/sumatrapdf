pdf: recycle numeric objects per context

Every element of a TJ array becomes a pdf_obj_num via pdf_new_int /
pdf_new_real and is dropped by pdf_clear_stack after the operator: an
fz_malloc and an fz_free, each under FZ_LOCK_ALLOC with the scavenging
allocator, per kerning offset in the content stream. On a kerned-text-heavy
document that was ~1 s of a 20 s text extraction.

Keep up to 1024 dead numeric objects on a list hanging off the fz_context.
The context is per thread, so the list needs no lock; the next pointer
overlays the dead object's first bytes. fz_clone_context gives the clone an
empty list; fz_drop_context frees whatever is left. Only PDF_INT / PDF_REAL
objects (fixed size) are recycled; strings, names and refs still go through
fz_free.
---
diff --git a/include/mupdf/fitz/context.h b/include/mupdf/fitz/context.h
index 73deb40f4..07d0ec2d2 100644
--- a/include/mupdf/fitz/context.h
+++ b/include/mupdf/fitz/context.h
@@ -915,6 +915,10 @@ struct fz_context
 	/* unshared contexts */
 	fz_aa_context aa;
 	uint16_t seed48[7];
+	/* recycled numeric pdf objects (pdf_new_int / pdf_new_real); singly
+	 * linked through the dead object's first bytes, freed in fz_drop_context */
+	void *num_obj_freelist;
+	int num_obj_freelist_len;
 #if FZ_ENABLE_ICC
 	int icc_enabled;
 #endif
diff --git a/source/fitz/context.c b/source/fitz/context.c
index 200e244ad..0a3a9250d 100644
--- a/source/fitz/context.c
+++ b/source/fitz/context.c
@@ -227,6 +227,15 @@ fz_drop_context(fz_context *ctx)
 
 	assert(ctx->error.top == ctx->error.stack_base);
 
+	/* Recycled small objects (see pdf_new_int); next pointer at offset 0. */
+	while (ctx->num_obj_freelist)
+	{
+		void *next = *(void **)ctx->num_obj_freelist;
+		ctx->alloc.free(ctx->alloc.user, ctx->num_obj_freelist);
+		ctx->num_obj_freelist = next;
+	}
+	ctx->num_obj_freelist_len = 0;
+
 	/* Free the context itself */
 	if (ctx->master == ctx && ctx->context_count != 0)
 	{
@@ -340,6 +349,10 @@ fz_clone_context(fz_context *ctx)
 	/* Reset error context to initial state. */
 	fz_init_error_context(new_ctx);
 
+	/* The recycled-object list is per context, not shared with the clone. */
+	new_ctx->num_obj_freelist = NULL;
+	new_ctx->num_obj_freelist_len = 0;
+
 	/* Then keep lock checking happy by keeping shared contexts with new context */
 	fz_keep_document_handler_context(new_ctx);
 	fz_keep_archive_handler_context(new_ctx);
diff --git a/source/pdf/pdf-object.c b/source/pdf/pdf-object.c
index b30935925..f05bfcaf6 100644
--- a/source/pdf/pdf-object.c
+++ b/source/pdf/pdf-object.c
@@ -171,11 +171,49 @@ struct pdf_journal
 #define ARRAY(obj) ((pdf_obj_array *)(obj))
 #define REF(obj) ((pdf_obj_ref *)(obj))
 
+/* The content-stream interpreter creates and drops a numeric object for every
+ * element of every TJ array. Recycle them on a per-context list (the context
+ * is per thread, so no lock) instead of a locked fz_malloc / fz_free each time.
+ * The next pointer overlays the dead object's first bytes (offset 0). */
+#define NUM_OBJ_FREELIST_MAX 1024
+
+static pdf_obj_num *
+alloc_num_obj(fz_context *ctx)
+{
+	pdf_obj_num *obj = ctx->num_obj_freelist;
+	if (obj)
+	{
+		ctx->num_obj_freelist = *(void **)obj;
+		ctx->num_obj_freelist_len--;
+		return obj;
+	}
+	return Memento_label(fz_malloc(ctx, sizeof(pdf_obj_num)), "pdf_obj(num)");
+}
+
+static void
+free_num_obj(fz_context *ctx, pdf_obj *obj)
+{
+	if (ctx->num_obj_freelist_len >= NUM_OBJ_FREELIST_MAX)
+	{
+		fz_free(ctx, obj);
+		return;
+	}
+	*(void **)obj = ctx->num_obj_freelist;
+	ctx->num_obj_freelist = obj;
+	ctx->num_obj_freelist_len++;
+}
+
+static int
+is_num_obj(pdf_obj *obj)
+{
+	return obj->kind == PDF_INT || obj->kind == PDF_REAL;
+}
+
 pdf_obj *
 pdf_new_int(fz_context *ctx, int64_t i)
 {
 	pdf_obj_num *obj;
-	obj = Memento_label(fz_malloc(ctx, sizeof(pdf_obj_num)), "pdf_obj(int)");
+	obj = alloc_num_obj(ctx);
 	obj->super.refs = 1;
 	obj->super.kind = PDF_INT;
 	obj->super.flags = 0;
@@ -187,7 +225,7 @@ pdf_obj *
 pdf_new_real(fz_context *ctx, float f)
 {
 	pdf_obj_num *obj;
-	obj = Memento_label(fz_malloc(ctx, sizeof(pdf_obj_num)), "pdf_obj(real)");
+	obj = alloc_num_obj(ctx);
 	obj->super.refs = 1;
 	obj->super.kind = PDF_REAL;
 	obj->super.flags = 0;
@@ -3156,6 +3194,8 @@ pdf_drop_obj(fz_context *ctx, pdf_obj *obj)
 				fz_free(ctx, STRING(obj)->text);
 				fz_free(ctx, obj);
 			}
+			else if (is_num_obj(obj))
+				free_num_obj(ctx, obj);
 			else
 				fz_free(ctx, obj);
 		}
@@ -3192,6 +3232,8 @@ pdf_drop_singleton_obj(fz_context *ctx, pdf_obj *obj)
 		fz_free(ctx, STRING(obj)->text);
 		fz_free(ctx, obj);
 	}
+	else if (is_num_obj(obj))
+		free_num_obj(ctx, obj);
 	else
 		fz_free(ctx, obj);
 
