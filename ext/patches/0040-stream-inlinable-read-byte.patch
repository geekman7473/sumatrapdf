stream: keep fz_read_byte / fz_peek_byte inlinable

Both are static inline in stream.h, but their refill path holds a fz_try,
i.e. a setjmp, and MSVC never inlines a function that contains setjmp (and
gives it the /GS cookie prologue). So every byte the content-stream lexer
reads was a real call: pdf_lex was 18% of text extraction with fz_read_byte
visible as its own frame even at /O2, plus __security_push/pop_cookie.

Move the refill (with its fz_try) out of line into fz_read_byte_slow /
fz_peek_byte_slow in stream-read.c; the inline part is just the rp != wp
fast path. Behaviour is unchanged.
---
diff --git a/include/mupdf/fitz/stream.h b/include/mupdf/fitz/stream.h
index 6fa79c041..ff188e037 100644
--- a/include/mupdf/fitz/stream.h
+++ b/include/mupdf/fitz/stream.h
@@ -439,27 +439,17 @@ static inline size_t fz_available(fz_context *ctx, fz_stream *stm, size_t max)
 	Returns -1 for end of stream, or the next byte. May
 	throw exceptions.
 */
+int fz_read_byte_slow(fz_context *ctx, fz_stream *stm);
+int fz_peek_byte_slow(fz_context *ctx, fz_stream *stm);
+
 static inline int fz_read_byte(fz_context *ctx, fz_stream *stm)
 {
-	int c = EOF;
-
+	/* The refill path holds a fz_try (setjmp), and MSVC never inlines a
+	 * function containing setjmp, so it lives out of line to keep this
+	 * common case inlinable. */
 	if (stm->rp != stm->wp)
 		return *stm->rp++;
-	if (stm->eof)
-		return EOF;
-	fz_try(ctx)
-		c = stm->next(ctx, stm, 1);
-	fz_catch(ctx)
-	{
-		fz_rethrow_if(ctx, FZ_ERROR_TRYLATER);
-		fz_report_error(ctx);
-		fz_warn(ctx, "read error; treating as end of file");
-		stm->error = 1;
-		c = EOF;
-	}
-	if (c == EOF)
-		stm->eof = 1;
-	return c;
+	return fz_read_byte_slow(ctx, stm);
 }
 
 /**
@@ -471,30 +461,9 @@ static inline int fz_read_byte(fz_context *ctx, fz_stream *stm)
 */
 static inline int fz_peek_byte(fz_context *ctx, fz_stream *stm)
 {
-	int c = EOF;
-
 	if (stm->rp != stm->wp)
 		return *stm->rp;
-	if (stm->eof)
-		return EOF;
-
-	fz_try(ctx)
-	{
-		c = stm->next(ctx, stm, 1);
-		if (c != EOF)
-			stm->rp--;
-	}
-	fz_catch(ctx)
-	{
-		fz_rethrow_if(ctx, FZ_ERROR_TRYLATER);
-		fz_report_error(ctx);
-		fz_warn(ctx, "read error; treating as end of file");
-		stm->error = 1;
-		c = EOF;
-	}
-	if (c == EOF)
-		stm->eof = 1;
-	return c;
+	return fz_peek_byte_slow(ctx, stm);
 }
 
 /**
diff --git a/source/fitz/stream-read.c b/source/fitz/stream-read.c
index 16f16f0aa..c1bddcdea 100644
--- a/source/fitz/stream-read.c
+++ b/source/fitz/stream-read.c
@@ -26,6 +26,55 @@
 
 #define MIN_BOMB (100 << 20)
 
+/* Refill paths of the inline fz_read_byte / fz_peek_byte (see stream.h). */
+int
+fz_read_byte_slow(fz_context *ctx, fz_stream *stm)
+{
+	int c = EOF;
+
+	if (stm->eof)
+		return EOF;
+	fz_try(ctx)
+		c = stm->next(ctx, stm, 1);
+	fz_catch(ctx)
+	{
+		fz_rethrow_if(ctx, FZ_ERROR_TRYLATER);
+		fz_report_error(ctx);
+		fz_warn(ctx, "read error; treating as end of file");
+		stm->error = 1;
+		c = EOF;
+	}
+	if (c == EOF)
+		stm->eof = 1;
+	return c;
+}
+
+int
+fz_peek_byte_slow(fz_context *ctx, fz_stream *stm)
+{
+	int c = EOF;
+
+	if (stm->eof)
+		return EOF;
+	fz_try(ctx)
+	{
+		c = stm->next(ctx, stm, 1);
+		if (c != EOF)
+			stm->rp--;
+	}
+	fz_catch(ctx)
+	{
+		fz_rethrow_if(ctx, FZ_ERROR_TRYLATER);
+		fz_report_error(ctx);
+		fz_warn(ctx, "read error; treating as end of file");
+		stm->error = 1;
+		c = EOF;
+	}
+	if (c == EOF)
+		stm->eof = 1;
+	return c;
+}
+
 size_t
 fz_read(fz_context *ctx, fz_stream *stm, unsigned char *buf, size_t len)
 {
